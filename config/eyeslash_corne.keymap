#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors/plover_hid.dtsi>
#include <dt-bindings/zmk/hid-io/plover_hid.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};


/ {
    behaviors {
        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };

        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };

        /* Shift on Space/Enter that only counts as Shift for keys on the OPPOSITE hand.
         * Pressing it together with a same-hand key quickly gives the tap (Space/Enter) instead.
         * Holding it past tapping-term-ms gives a plain Shift for any key.
         * Positions: row0 0-12, row1 13-27, row2 28-41, thumbs 42-47. The centre keys
         * (6, 19-21, 34, 35) are not listed on purpose, so they never trigger the hold.
         * To fall back to a plain key, swap `&shift_space LSHFT SPACE` for `&kp SPACE`.
         * Tuning: flavor "hold-preferred" without hold-trigger-on-release gives instant Shift
         * but misfires on rolls. */
        shift_space: shift_space {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            hold-trigger-key-positions = <7 8 9 10 11 12 22 23 24 25 26 27 36 37 38 39 40 41 45 46 47>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };

        shift_enter: shift_enter {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            hold-trigger-key-positions = <0 1 2 3 4 5 13 14 15 16 17 18 28 29 30 31 32 33 42 43 44>;
            hold-trigger-on-release;
            bindings = <&kp>, <&kp>;
        };
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        tap-ms = <100>;
    };


    /* Same-finger chords (top+home, home+bottom of one column), after the Kombol layout
     * (https://github.com/skychil/kombol), base layer only. Defaults live here; DYA Studio
     * can override or reset each slot at runtime. Shift turns - = [ ] into _ + { }.
     * Key positions: row0 0-12, row1 13-27, row2 28-41, thumbs 42-47. */
    runtime_combo_defaults {
        compatible = "cormoran,runtime-combo-defaults";

        /* Space + Enter together: hold the Fn layer. Never a real shortcut, so no clash. */
        combo_fn_layer {
            key-positions = <44 45>;
            bindings = <&mo 3>;
            layers = <0>;
            display-name = "Fn layer (Space+Enter)";
        };

        combo_exclaim {
            key-positions = <1 14>;
            bindings = <&kp EXCL>;
            layers = <0>;
            display-name = "!";
        };

        combo_grave {
            key-positions = <14 29>;
            bindings = <&kp GRAVE>;
            layers = <0>;
            display-name = "`";
        };

        combo_at {
            key-positions = <2 15>;
            bindings = <&kp AT>;
            layers = <0>;
            display-name = "@";
        };

        combo_tilde {
            key-positions = <15 30>;
            bindings = <&kp TILDE>;
            layers = <0>;
            display-name = "~";
        };

        combo_hash {
            key-positions = <3 16>;
            bindings = <&kp HASH>;
            layers = <0>;
            display-name = "#";
        };

        combo_dollar {
            key-positions = <16 31>;
            bindings = <&kp DLLR>;
            layers = <0>;
            display-name = "$";
        };

        combo_percent {
            key-positions = <4 17>;
            bindings = <&kp PRCNT>;
            layers = <0>;
            display-name = "%";
        };

        combo_caret {
            key-positions = <17 32>;
            bindings = <&kp CARET>;
            layers = <0>;
            display-name = "^";
        };

        combo_ampersand {
            key-positions = <5 18>;
            bindings = <&kp AMPS>;
            layers = <0>;
            display-name = "&";
        };

        combo_asterisk {
            key-positions = <18 33>;
            bindings = <&kp ASTRK>;
            layers = <0>;
            display-name = "*";
        };

        combo_lparen {
            key-positions = <7 22>;
            bindings = <&kp LPAR>;
            layers = <0>;
            display-name = "(";
        };

        combo_rparen {
            key-positions = <22 36>;
            bindings = <&kp RPAR>;
            layers = <0>;
            display-name = ")";
        };

        combo_lbracket {
            key-positions = <8 23>;
            bindings = <&kp LBKT>;
            layers = <0>;
            display-name = "[";
        };

        combo_rbracket {
            key-positions = <23 37>;
            bindings = <&kp RBKT>;
            layers = <0>;
            display-name = "]";
        };

        combo_lbrace {
            key-positions = <9 24>;
            bindings = <&kp LBRC>;
            layers = <0>;
            display-name = "{";
        };

        combo_rbrace {
            key-positions = <24 38>;
            bindings = <&kp RBRC>;
            layers = <0>;
            display-name = "}";
        };

        combo_langle {
            key-positions = <10 25>;
            bindings = <&kp LT>;
            layers = <0>;
            display-name = "<";
        };

        combo_rangle {
            key-positions = <25 39>;
            bindings = <&kp GT>;
            layers = <0>;
            display-name = ">";
        };

        combo_minus {
            key-positions = <11 26>;
            bindings = <&kp MINUS>;
            layers = <0>;
            display-name = "-";
        };

        combo_equal {
            key-positions = <26 40>;
            bindings = <&kp EQUAL>;
            layers = <0>;
            display-name = "=";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "COLEMAK-DH";
            bindings = <
&kp TAB        &kp Q  &kp W      &kp F     &kp P  &kp B                              &kp UP                &kp J            &kp L  &kp U      &kp Y    &kp SEMI  &kp BSPC
&mt LCTRL ESC  &kp A  &kp R      &kp S     &kp T  &kp G                    &kp LEFT  &kp ENTER  &kp RIGHT  &kp M            &kp N  &kp E      &kp I    &kp O     &kp SQT
&lt 3 GRAVE    &kp Z  &kp X      &kp C     &kp D  &kp V       &kp SPACE              &kp DOWN              &kp K            &kp H  &kp COMMA  &kp DOT  &kp FSLH  &lt 3 BSLH
                                 &kp LGUI  &kp LALT  &shift_space LSHFT SPACE                              &shift_enter RSHFT ENTER  &mo 1  &mo 2
            >;
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        lower_layer {
            display-name = "NUMBER";
            bindings = <
&trans  &kp N1           &kp N2          &kp N3        &kp N4        &kp N5                                        &mmv MOVE_UP                     &kp N6           &kp N7           &kp N8           &kp N9           &kp N0    &kp BSPC
&trans  &bt BT_CLR_ALL   &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3                           &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp LEFT         &kp DOWN         &kp UP           &kp RIGHT        &kp HOME  &kp PG_UP
&trans  &rgb_ug RGB_OFF  &rgb_ug RGB_ON  &trans        &trans        &rgb_ug RGB_EFF &kp C_MUTE                    &mmv MOVE_DOWN                   &rgb_ug RGB_EFR  &rgb_ug RGB_SPI  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &kp END   &kp PG_DN
                                         &trans        &trans        &trans                                                                         &kp INS          &kp DEL          &trans
            >;
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        raise_layer {
            display-name = "SYMBOL";
            bindings = <
&trans  &kp EXCL      &kp AT        &kp HASH   &kp DLLR   &kp PRCNT                           &mmv MOVE_UP                     &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR  &kp RPAR  &kp BSPC
&trans  &bt BT_CLR    &mkp LCLK     &mkp MCLK  &mkp RCLK  &mkp MB4            &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT  &kp BSLH  &kp GRAVE
&trans  &out OUT_USB  &out OUT_BLE  &none      &none      &mkp MB5  &trans                    &mmv MOVE_DOWN                   &kp UNDER  &kp PLUS   &kp LBRC   &kp RBRC  &kp PIPE  &kp TILDE
                                    &trans     &trans     &kp SPACE                                                            &kp RET    &trans     &trans
            >;
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer_3 {
            display-name = "Fn";
            bindings = <
&studio_unlock   &kp F1      &kp F2      &kp F3       &kp F4     &kp F5                                  &mmv MOVE_UP                     &kp F6       &kp F7     &kp F8       &kp F9      &kp F10          &kp F11
&to 4   &trans      &mkp LCLK   &mkp MCLK    &mkp RCLK  &mkp MB4                &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &bootloader  &mkp LCLK  &mkp MCLK    &mkp RCLK   &kp PRINTSCREEN  &kp F12
&trans  &sys_reset  &trans      &bootloader  &trans     &mkp MB5  &kp C_MUTE                    &mmv MOVE_DOWN                   &trans       &trans     &bootloader  &sys_reset  &kp SCROLLLOCK   &kp PAUSE_BREAK
                                &trans      &trans      &trans                                                                   &trans       &trans     &trans
            >;
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        /* Plover HID steno layer. Enter: &to 4 on the Fn layer (below studio_unlock).
         * Leave: &to 0 in the same position here. Left outer column and the bottom
         * rows are unused; arrows/enter/space fall through (&trans) to layer 0. */
        steno_layer {
            display-name = "STENO";
            bindings = <
&none   &plv PLV_SL   &plv PLV_TL  &plv PLV_PL  &plv PLV_HL  &plv PLV_ST                                  &trans                  &plv PLV_ST3  &plv PLV_FR  &plv PLV_PR  &plv PLV_LR  &plv PLV_TR  &plv PLV_DR
&to 0   &plv PLV_SL2  &plv PLV_KL  &plv PLV_WL  &plv PLV_RL  &plv PLV_ST2                        &trans  &trans  &trans  &plv PLV_ST4  &plv PLV_RR  &plv PLV_BR  &plv PLV_GR  &plv PLV_SR  &plv PLV_ZR
&none   &none         &none        &none        &none        &none        &trans                          &trans                  &none         &none        &none        &none        &none        &none
                                                &plv PLV_NM  &plv PLV_A   &plv PLV_O                                              &plv PLV_E    &plv PLV_U   &plv PLV_NM2
            >;
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };
    };
};